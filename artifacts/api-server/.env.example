# --- Server ---
PORT=4000
NODE_ENV=development

# --- PostgreSQL (drizzle-orm) ---
DATABASE_URL=postgres://user:password@localhost:5432/northline

# --- Clerks ---
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# --- Google Cloud Storage (object uploads) ---
# Used by artifacts/api-server/src/lib/objectStorage.ts
# Auth is via GOOGLE_APPLICATION_CREDENTIALS (service-account JSON path)
# or workload identity on the host running the server.
GCS_PROJECT_ID=your-gcp-project-id
PUBLIC_OBJECT_SEARCH_PATHS=/your-public-bucket/public
PRIVATE_OBJECT_DIR=/your-private-bucket/private

# --- CORS ---
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
