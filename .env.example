# =============================================================================
# Local development secrets.
# Copy this file to `.env` (repo root) and fill in real values.
# The api-server picks this up automatically via dotenv (see artifacts/api-server/src/index.ts).
# =============================================================================

# --- Database (Postgres / Supabase) ---
DATABASE_URL=postgres://user:password@localhost:5432/northline

# --- Clerk auth (portal + api-server) ---
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# --- Google Cloud Storage (api-server uploads) ---
# Auth is picked up via GOOGLE_APPLICATION_CREDENTIALS (service-account JSON path on the host).
GCS_PROJECT_ID=your-gcp-project-id
PUBLIC_OBJECT_SEARCH_PATHS=/your-public-bucket/public
PRIVATE_OBJECT_DIR=/your-private-bucket/private

# --- API server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
